# Public demonstration credentials only. Replace for any non-local deployment.
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments-local-demo
POSTGRES_DB=payments
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=rabbit-local-demo
DATABASE_URL=postgresql+asyncpg://payments:payments-local-demo@localhost:5432/payments
RABBITMQ_URL=amqp://payments:rabbit-local-demo@localhost:5672/
API_KEY=demo-api-key
OUTBOX_POLL_INTERVAL=1
OUTBOX_BATCH_SIZE=100
PAYMENT_PROCESSING_MIN_DELAY=2
PAYMENT_PROCESSING_MAX_DELAY=5
PAYMENT_SUCCESS_RATE=0.9
MESSAGE_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1
RETRY_MULTIPLIER=2
WEBHOOK_TIMEOUT=10
BROKER_TIMEOUT=5
